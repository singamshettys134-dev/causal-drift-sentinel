# --- LLM reasoning layer ---
# Single swappable config value (spec Section 4/7) — change this to upgrade models.
# Backed by Groq's OpenAI-compatible chat completions API.
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...
LLM_MAX_TOKENS=2000

# --- DataHub integration ---
# Self-hosted: mcp-server-datahub runs as a local stdio subprocess (same as
# Claude Desktop/Cursor connect to it) using these two vars, passed straight
# through to that subprocess.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
# How to launch the subprocess. Default assumes `uv` is installed:
DATAHUB_MCP_COMMAND=uvx
DATAHUB_MCP_ARGS=mcp-server-datahub
# DataHub Cloud's managed MCP server instead uses a URL/SSE connection — if
# set, this takes priority over the subprocess above.
DATAHUB_MCP_URL=
# Mutation tools (add_tags, update_description) are opt-in on both sides —
# must match TOOLS_IS_MUTATION_ENABLED on the DataHub MCP server itself.
DATAHUB_MUTATION_ENABLED=false

# --- GitHub integration ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/causal-drift-sentinel
# Explicit opt-in required for live write-backs (safety gate for public demos).
WRITEBACK_ENABLED=false

# --- CORS ---
# Comma-separated list of allowed frontend origins. Keep "*" for local dev only;
# set this to your deployed frontend's exact URL before going public.
ALLOWED_ORIGINS=*

# --- Drift thresholds ---
KS_PVALUE_ALERT_THRESHOLD=0.05
PSI_LOW_THRESHOLD=0.1
PSI_MODERATE_THRESHOLD=0.2
PSI_HIGH_THRESHOLD=0.3
EMBEDDING_COSINE_DRIFT_THRESHOLD=0.15

# --- Causal isolation ---
INTERVENTION_DELTA_MIN=0.05

# --- App ---
# true = use MockDataHubClient + synthetic demo data (no live DataHub needed)
USE_MOCK_DATAHUB=true
ENV=development
