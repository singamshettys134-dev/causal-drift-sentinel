# --- LLM reasoning layer ---
# Single swappable config value (spec Section 4/7) — change this to upgrade models.
# Backed by Groq's OpenAI-compatible chat completions API.
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...
LLM_MAX_TOKENS=2000

# --- DataHub integration ---
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=
DATAHUB_MCP_URL=http://localhost:8090/mcp

# --- GitHub integration ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/causal-drift-sentinel
# Explicit opt-in required for live write-backs (safety gate for public demos).
WRITEBACK_ENABLED=false

# --- CORS ---
# Comma-separated list of allowed frontend origins. Keep "*" for local dev only;
# set this to your deployed frontend's exact URL before going public.
ALLOWED_ORIGINS=*

# --- Drift thresholds ---
KS_PVALUE_ALERT_THRESHOLD=0.05
PSI_LOW_THRESHOLD=0.1
PSI_MODERATE_THRESHOLD=0.2
PSI_HIGH_THRESHOLD=0.3
EMBEDDING_COSINE_DRIFT_THRESHOLD=0.15

# --- Causal isolation ---
INTERVENTION_DELTA_MIN=0.05

# --- App ---
# true = use MockDataHubClient + synthetic demo data (no live DataHub needed)
USE_MOCK_DATAHUB=true
ENV=development
