# Leave unset for local dev — Vite's dev-server proxy (vite.config.js) forwards
# /api requests to http://localhost:8000 automatically.
#
# For a production deploy where the frontend and backend are hosted separately
# (e.g. frontend on Vercel, backend on Render), set this to your deployed
# backend's full URL (no trailing slash):
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
